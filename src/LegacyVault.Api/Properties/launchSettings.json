{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "google-dev": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5000",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ConnectionStrings__Default": "Server=localhost,1433;Database=LegacyVault_OfficialDev;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Connect Timeout=5",
        "CheckIn__Enabled": "false",
        "Handover__Job__Enabled": "false"
      }
    },
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:5000",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    }
  }
}
