# Copy to .env, then replace CHANGE_ME with a local development password.
# setup-local.ps1 generates a random password if this value is unchanged.
# Simple unquoted values only. Password: 8-128 characters, letters/digits/!@#%_+=.-,
# with at least 3 of uppercase/lowercase/digit/symbol categories.
COMPOSE_PROJECT_NAME=legacyvault-starter
SQL_PORT=14331
SQL_DATABASE=LegacyVault
SQL_PASSWORD=CHANGE_ME
