# ==============================================================================
# LegacyVault Backend (ASP.NET Core .NET 10) - Production Environment Variables
# Copy or set these in Render Dashboard (Environment tab)
# ==============================================================================

# 1. Server & Hosting Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=10000
AllowedHosts=*

# 2. Database (SQL Server 2022 / Azure SQL Database)
# Lưu ý: Backend dùng EF Core SqlServer. Chuỗi kết nối phải trỏ đến máy chủ SQL Server thực tế.
# Tên biến PHẢI là ConnectionStrings__Default (không phải "Server=..." đứng một mình).
ConnectionStrings__Default=Server=your-sql-server.database.windows.net,1433;Database=LegacyVault_Prod;User Id=your_user;Password=your_password;Encrypt=True;TrustServerCertificate=True;Connect Timeout=60;
Database__MigrateOnStartup=true

# 3. CORS & Client URL (Địa chỉ Frontend trên Vercel)
Cors__AllowedOrigins__0=https://your-legacyvault.vercel.app
App__ClientUrl=https://your-legacyvault.vercel.app
# Bắt buộc khi FE (Vercel) và Backend (Render) khác domain để cookie lv_refresh hoạt động
Auth__CrossSiteCookies=true

# 4. JWT Authentication
Jwt__Issuer=LegacyVault
Jwt__Audience=LegacyVault
# Khóa bí mật tối thiểu 32 ký tự ngẫu nhiên
Jwt__SigningKey=CHANGE_ME_TO_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS_LONG!
Jwt__AccessTokenMinutes=90

# 5. External Integrations
# Google OAuth 2.0 Web Client ID (trùng với Client Frontend)
GoogleAuth__ClientId=717961939025-32a9snln6rvn7pu3va9are8dhcabvmr7.apps.googleusercontent.com

# eKYC AI microservice
Ekyc__BaseUrl=https://legacyvault-ekyc.onrender.com
Ekyc__ApiKey=
Ekyc__TimeoutSeconds=60

# Google Gemini AI API Key (Dành cho trợ lý Notary Co-pilot duyệt hồ sơ chứng tử)
Gemini__ApiKey=YOUR_GEMINI_API_KEY_HERE

# 6. Storage (Tài sản mã hóa)
# "Local" (ổ đĩa container/persistent disk) hoặc "R2" (Cloudflare R2 S3-compatible)
AssetStorage__Provider=R2
AssetStorage__RootPath=App_Data/asset-content
AssetStorage__R2__AccountId=YOUR_R2_ACCOUNT_ID
AssetStorage__R2__BucketName=your-private-bucket
AssetStorage__R2__AccessKeyId=YOUR_R2_ACCESS_KEY_ID
AssetStorage__R2__SecretAccessKey=YOUR_R2_SECRET_ACCESS_KEY

# Khóa Master AES-256 KEK (Base64 32 bytes)
# Sinh bằng PowerShell: $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
AssetEncryption__ActiveKeyId=prod-2026-10
AssetEncryption__Keys__prod-2026-10=CHANGE_ME_TO_BASE64_32_BYTES_KEY==
AssetEncryption__BlindIndexKey=CHANGE_ME_TO_ANOTHER_BASE64_32_BYTES_KEY==

# 7. Email SMTP (Gửi thông báo & mời Executor/Beneficiary)
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__SecureSocket=StartTls
Email__Smtp__FromName=LegacyVault
Email__Smtp__UserName=your_email@gmail.com
Email__Smtp__Password=your_app_password_here
Email__Smtp__FromAddress=your_email@gmail.com

# 8. Background Jobs & Feature Toggles
Handover__RequireIdentityVerification=true
Handover__Job__Enabled=true
Handover__Job__PollSeconds=60
CheckIn__Enabled=true
CheckIn__PollSeconds=60
